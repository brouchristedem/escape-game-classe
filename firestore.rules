rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Structure multi-tenant : chaque jeu vit sous games/{gameId}. La
    // lecture reste ouverte à tous (nécessaire pour les pages joueur,
    // publiques et non authentifiées, sous /g/{gameId}). L'écriture sur le
    // document du jeu et sur son circuit (questions/équipes) est réservée
    // aux organisateurs de CE jeu précis : un vrai compte Firebase Auth
    // (Phase 2 du passage multi-tenant) dont l'uid figure dans le tableau
    // organizers du jeu. Ça remplace le mot de passe unique partagé côté
    // client de la Phase 1, qui ne protégeait rien côté serveur.
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.organizers;
      allow update, delete: if request.auth != null
                            && request.auth.uid in resource.data.organizers;

      match /questions/{questionId} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.uid in
                        get(/databases/$(database)/documents/games/$(gameId)).data.organizers;
      }
      match /teams/{teamId} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.uid in
                        get(/databases/$(database)/documents/games/$(gameId)).data.organizers;
      }
      // État en direct de l'écran du chef d'équipe : écrit par les équipes
      // elles-mêmes pendant la partie (joueurs non authentifiés), donc reste
      // ouvert. Ce n'est pas une donnée sensible côté organisateur.
      match /liveState/{teamId} {
        allow read: if true;
        allow write: if true;
      }
      // Formation des équipes : un participant (non authentifié) s'inscrit
      // avec un nom court, seulement tant que l'organisateur a ouvert les
      // inscriptions ; l'affectation à une équipe (update) et la suppression
      // sont réservées aux organisateurs du jeu.
      match /inscriptions/{inscriptionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nom', 'niveau', 'createdAt'])
                      && request.resource.data.nom is string
                      && request.resource.data.nom.size() > 0
                      && request.resource.data.nom.size() <= 40
                      && request.resource.data.niveau is string
                      && request.resource.data.niveau.size() > 0
                      && request.resource.data.niveau.size() <= 40
                      && request.resource.data.createdAt == request.time
                      && get(/databases/$(database)/documents/games/$(gameId)).data.get('inscriptionsOuvertes', false) == true;
        allow update, delete: if request.auth != null
                              && request.auth.uid in
                                 get(/databases/$(database)/documents/games/$(gameId)).data.organizers;
      }
      // Événements surprise : une équipe (non authentifiée) enregistre sa
      // première bonne réponse, une seule fois (création seule, jamais de
      // modification), avec l'heure du serveur — c'est elle qui départage
      // les équipes.
      match /evenements/{eventId}/bonnes/{teamId} {
        allow read: if true;
        allow create: if request.resource.data.at == request.time;
      }
    }
  }
}
